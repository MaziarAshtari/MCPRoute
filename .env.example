# MCPRoute configuration. Copy to `.env` and fill in the required values.
# Local runs load it automatically (`pnpm dev`, `pnpm db:migrate`, `pnpm start`).
# `docker compose` reads it too, but only passes MASTER_KEY, ADMIN_*, SESSION_TTL_MINUTES and the
# optional settings into the container (PORT becomes the host port; the database lives on a volume).

# --- Required ---------------------------------------------------------------

# 32 random bytes (64 hex chars or base64) used to encrypt upstream API keys at rest (AES-256-GCM).
# Generate one with: openssl rand -hex 32
# Back it up: stored API keys cannot be decrypted without it.
MASTER_KEY=

# Admin login for the web UI and the /api routes. The password must be at least 8 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Server -----------------------------------------------------------------

# HTTP port of the API server (which also serves the built web UI).
PORT=3000

# SQLite database file. Relative paths are resolved against the directory of this file.
DATABASE_PATH=./data/mcproute.db

# Idle lifetime of an MCP session and its API key bindings, in minutes.
SESSION_TTL_MINUTES=60

# --- Gateway ----------------------------------------------------------------

# Timeout for connecting to an upstream MCP server (proxy/TCP connect + initialize) and for proxy checks.
# UPSTREAM_CONNECT_TIMEOUT_MS=15000

# Timeout for a single forwarded upstream request, e.g. tools/call.
# UPSTREAM_CALL_TIMEOUT_MS=120000

# Request logs older than this many days are deleted.
# LOG_RETENTION_DAYS=30

# URL fetched through each proxy by the proxy health check (must return {"ip": "..."} or a bare IP).
# PROXY_CHECK_URL=https://api.ipify.org?format=json

# --- Optional ---------------------------------------------------------------

# Interface to bind when running locally; use 0.0.0.0 to accept remote connections.
# HOST=127.0.0.1

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Trust X-Forwarded-* headers from a reverse proxy (e.g. Caddy). Set to false when exposed directly.
# TRUST_PROXY=true

# Secure flag of the admin session cookie: auto (only on HTTPS requests) | true | false
# COOKIE_SECURE=auto
